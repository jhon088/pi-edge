{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PX Kiosk",
  "version": "1.0.0",
  "identifier": "com.pxcommerce.pxkiosk",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "PX Kiosk",
        "width": 1280,
        "height": 900,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost ws://localhost:1420"
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "publisher": "PX Commerce",
    "copyright": "© PX Commerce",
    "category": "Business",
    "shortDescription": "Self-service kiosk for restaurant and retail",
    "longDescription": "PX Kiosk — the self-service screen for PX Commerce, as a restaurant kiosk or a retail self-checkout, running entirely on the machine it is installed on.",
    "resources": {
      "../../../demo/menu.json": "demo/menu.json",
      "../../../demo/assets/": "demo/assets/",
      "../../../demo/retail/menu.json": "demo/retail/menu.json",
      "../../../demo/retail/assets/": "demo/retail/assets/"
    },
    "targets": "all"
  }
}
