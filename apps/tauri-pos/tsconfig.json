{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    // Tests run straight through Node, which resolves the real file
    // name — so they import `./selection.ts` and the compiler has to
    // accept the extension it is actually written with.
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "noEmit": true,
    // `node` for the test files: they run straight through Node's own
    // test runner, so they import `node:test` and `node:assert`.
    "types": ["vite/client", "node"]
  },
  "include": ["src", "vite.config.ts"]
}
